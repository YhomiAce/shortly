// Prisma schema for shortly. The connection URL lives in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A short link that redirects `/<slug>` to `targetUrl`.
model Link {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique @db.VarChar(64)
  targetUrl    String    @map("target_url")
  title        String?   @db.VarChar(200)
  passwordHash String?   @map("password_hash")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  clicks       Click[]

  @@index([createdAt])
  @@map("links")
}

/// One recorded visit of a short link.
model Click {
  id           BigInt   @id @default(autoincrement())
  linkId       String   @map("link_id") @db.Uuid
  link         Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt    DateTime @map("clicked_at") @db.Timestamptz(3)
  referrerHost String?  @map("referrer_host") @db.VarChar(255)
  device       String   @db.VarChar(32)
  browser      String   @db.VarChar(64)
  os           String   @db.VarChar(64)
  country      String   @db.VarChar(16)

  @@index([linkId, clickedAt])
  @@index([clickedAt])
  @@map("clicks")
}

/// An API key for the management API. Only a SHA-256 hash of the key is stored.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  prefix     String    @db.VarChar(16)
  keyHash    String    @unique @map("key_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@map("api_keys")
}
