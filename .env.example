# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shortly
# Redis connection string (database index in the path)
REDIS_URL=redis://127.0.0.1:6379/0
# Bootstrap API key for the management API (min 16 chars). Generate one with: openssl rand -base64 32
ADMIN_API_KEY=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call the API ("*" for any, empty to disable CORS)
CORS_ORIGINS=http://localhost:5173
# Public base URL used to build short URLs (defaults to http://localhost:$PORT)
PUBLIC_BASE_URL=http://localhost:5102
# HTTP port (default 5102)
PORT=5102
# Optional: link creations allowed per API key per minute (default 30)
# RATE_LIMIT_CREATE_PER_MINUTE=30
# Optional: set to false to skip sample data on first start
# SEED_SAMPLE_DATA=true
